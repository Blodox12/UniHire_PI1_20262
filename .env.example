DJANGO_SECRET_KEY=tu_clave_secreta_aqui

# Security (NFR-02). Keep DEBUG=True only on your own machine.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Needed when deployed behind HTTPS, e.g. https://unihire.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Folder for `python manage.py backup_db` (NFR-09). Defaults to ./backups
DJANGO_BACKUP_DIR=
# Email for password reset. Leave EMAIL_HOST_USER empty to print emails to the console.
# Gmail: enable 2-step verification and create an App Password at
# https://myaccount.google.com/apppasswords (use it as EMAIL_HOST_PASSWORD, not your normal password).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Optional, defaults to "UniHire <EMAIL_HOST_USER>"
DEFAULT_FROM_EMAIL=
